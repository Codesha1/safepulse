# ===== SafePulse configuration =====
# Copy this file to ".env" and edit the values. NEVER commit .env or share it.

PORT=3000
NODE_ENV=production

# The public address of your site (used in password-reset / welcome emails).
APP_URL=https://your-domain.com

# REQUIRED in production. A long random secret used to sign login sessions.
# Generate one with:  npm run gen-secret
AUTH_SECRET=

# true  = demo accounts + fictional sample data (good for presentations/judging)
# false = real mode: no demo data; create nurses with `npm run create-nurse`
DEMO_MODE=true
DEMO_PASSWORD=SafePulse-Demo-2026

# Set to true when the site is served over HTTPS (recommended in production).
COOKIE_SECURE=true

# Where data lives (relative to the project folder). Back these up.
DATABASE_PATH=data/safepulse.db
STORAGE_DIR=data/uploads

# School time zone (the school week is Sunday-Thursday).
TZ=Asia/Riyadh

# OPTIONAL — real AI food recognition (Anthropic). Leave empty to use demo estimates.
AI_API_KEY=
AI_MODEL=claude-sonnet-5-5

# OPTIONAL — real emails via Resend. Leave empty to show an on-screen email preview instead.
EMAIL_API_KEY=
EMAIL_FROM=SafePulse <noreply@your-domain.com>
